<?xml version="1.0" encoding="UTF-8"?>
<!--
  FRANKY TECH — sitemap.xml
  Only public marketing pages belong here. Authenticated app
  pages, the admin panel, and per-user share links are excluded —
  they're not meant to be indexed and have no stable canonical
  content for search engines to rank anyway. Update the <loc>
  domain once deployed to production.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://your-domain.example.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://your-domain.example.com/register.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://your-domain.example.com/login.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
