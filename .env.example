# ==========================================================
# FRANKY TECH — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to Git.
# ==========================================================

# --- Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://franky_user:franky_password@localhost:5432/franky_tech

# --- Sessions / Auth (used from Phase 3 onward) ---
SESSION_SECRET=replace_with_a_long_random_string

# --- Email (used from Phase 3 onward) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASSWORD=replace_with_real_password

# --- Payments (used from Phase 19 onward) ---
PAYMENT_SECRET_KEY=replace_with_real_key
PAYMENT_WEBHOOK_SECRET=replace_with_real_webhook_secret

# --- Storage (used from later phases, for logos / receipts / attachments) ---
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# --- Contact / Social (public, safe to expose to frontend) ---
WHATSAPP_NUMBER=237670113284
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61592926179073
TIKTOK_URL=https://www.tiktok.com/@franky.s44
INSTAGRAM_URL=https://www.instagram.com/franky_stylish65?igsh=c3Fsb3N5YWdvb2Fw
YOUTUBE_URL=https://youtube.com/@franky_stylish?si=nG6GonfckborRPBe
